# ==========================================
# SENTINELX SOC PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. Environment Mode ('production' or 'development')
# In 'production', wildcard CORS is disabled and strict security defaults apply.
ENVIRONMENT=production

# 2. Application Secret Key (CRITICAL: Must be a long random 32+ character string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_secure_random_production_secret_key_here_32chars

# 3. Allowed CORS Domain Origins
# Comma-separated list of origins permitted to communicate with the API.
# Example: https://sentinelx.yourdomain.com,https://soc.company.com
CORS_ORIGINS=https://sentinelx.yourdomain.com

# 4. Database Connection URL
# SQLite (Local persistent storage):
DATABASE_URL=sqlite:///./sentinelx.db
# PostgreSQL (High-volume production database):
# DATABASE_URL=postgresql://sentinelx_user:your_secure_db_password@localhost:5432/sentinelx_db

# 5. Initial Administrator & Analyst Setup Credentials
# These will be seeded into the database on the very first boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_prod!
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change_this_analyst_password_in_prod!

# 6. Detection Engine Sliding Windows & Default Thresholds
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_MINUTES=1
SUSPICIOUS_LOGIN_FAIL_THRESHOLD=3
SUSPICIOUS_LOGIN_WINDOW_MINUTES=5
EVENT_FLOOD_THRESHOLD=100
EVENT_FLOOD_WINDOW_MINUTES=1
